# Bu faylni `.env` nomi bilan nusxalang:  cp .env.example .env

# Server porti
PORT=4000

# JWT kaliti — production uchun MAJBURIY. Uzun tasodifiy qator bo'lsin, masalan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token amal qilish muddati (12h, 7d, ...)
JWT_EXPIRES_IN=12h

# Ma'lumotlar bazasi fayli (SQLite). Bo'sh qoldirilsa: backend/data/lc_crm.db
DB_PATH=

# Birinchi ishga tushishda yaratiladigan SUPER ADMIN.
# Production'da SUPER_ADMIN_PASSWORD berilmasa server ishga tushmaydi.
SUPER_ADMIN_LOGIN=superadmin
SUPER_ADMIN_PASSWORD=

# Faqat frontend boshqa domenda bo'lsa (vergul bilan ajrating): https://crm.example.uz
CORS_ORIGIN=
